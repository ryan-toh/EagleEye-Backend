# Select exactly one provider: ai_platform or soclaas.
AI_PROVIDER=ai_platform

# Keep provider keys private. They are never sent to the browser.
AI_PLATFORM_API_KEY=replace-with-your-api-key

# Confirm the model name available to your AI platform account.
# AI_PLATFORM_MODEL=gpt-5-nano
AI_PLATFORM_MODEL=granite4.2

# Optional overrides
# AI_PLATFORM_BASE_URL=https://api.ai.tech.gov.sg/platform/models
# CORS_ORIGINS=http://localhost:3000

AI_PLATFORM_BASE_URL="http://localhost:11434"

# SOCLAAS (used when AI_PROVIDER=soclaas)
# SOCLAAS_API_KEY=replace-with-your-soclaas-api-key
# SOCLAAS_BASE_URL=https://soclaas-api.comp.nus.edu.sg/v1
# SOCLAAS_MODEL=qwen3.5:9b
# SOCLAAS_REASONING_EFFORT=none
